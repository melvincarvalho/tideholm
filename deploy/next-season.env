# Tideholm — STAGED next-season config (NOT applied; the live game is untouched).
#
# Season-3 plan (decided 2026-07-18):
#   - pace & fairness stay as season 2: speed 1, default 72h real grace,
#     default 3x bully band ("aspirational — keeps humans paced")
#   - balance fixes are GAMEPLAY, not knobs:
#       * Beacon win level 6 (longer, more contested endgame)  -> below
#       * bot personalities #22 (SHIPPED): tempo spread, sleep windows,
#         temperament vectors, retaliation exemption, upward soft-target
#         override, warlords, barbarians (#19 folded in)
#         defaults ARE the decision: BOT_TEMPO=1,
#         BOT_PERSONAS=settler:15,warlord:2,barbarian:3
#   - stretch goal: barbarian islands #19 (cheap once #22 lands)
#
# Season-4 additions (decided 2026-07-28) — two logistics brakes the reference
# titles have and this game did not. BOTH activate on their own at the next
# world creation and are inert on any season already running, so there is
# nothing to switch on at the boundary. Recorded here because this file is the
# ruleset record, and neither would otherwise appear anywhere in deploy/.
#
#   * support costs its home island population #40 (SHIPPED, PR #65)
#       Stationed and in-flight support keeps consuming the farm space of the
#       island that raised it, so "train to cap -> ship out -> train again" no
#       longer repeats forever. NOT a knob: world.supportCostsPop, hardcoded
#       true in createWorld, backfilled false for existing saves.
#       (Supporting your OWN island was always a transfer into that garrison
#       and already cost population there — the loophole needed two players
#       supporting each other. Real, but narrower than the issue claimed.)
#
#   * merchant slots #30 (SHIPPED, PR #66)
#       A shipment ties up a Harbor slot for the ROUND TRIP, so distance costs
#       throughput rather than only patience. Market trades charge both sides;
#       the Tidepool is exempt. Knob below; world.tradeSlots is backfilled null
#       (unlimited) for existing saves.
#
# Injected at apply time by apply-next-season.sh (never stored here):
#   ADMIN_TOKEN  — read from the running process so the secret never lands in a file
#   WORLD_START  — computed as the next 18:00 Europe/Berlin (or passed as an arg)
#
# Apply only at the SEASON BOUNDARY:  ./deploy/apply-next-season.sh --confirm
# NOTE: the script targets the LOCAL testbed (pm2 tideholm-jss). Production
# lives on the nostr.social host — run the twin of this there.

# --- pace (same as season 2) ---
GAME_SPEED=1                 # classic hours pace; grace defaults to 72 real hours

# --- server (preserved from the live process) ---
PORT=3210

# --- endgame ---
WONDER_WIN_LEVEL=6           # Beacon wins at level 6 (was 5): ~9x base cost for
                             # the final level, storehouse ~12 to afford it, one
                             # more world-wide announcement to react to

# --- logistics brakes (#30) ---
TRADE_SLOTS_PER_HARBOR=1     # merchant slots per Harbor level; a shipment holds
                             # one for the round trip, so a far delivery ties up
                             # a merchant for twice the travel time. 1/level
                             # caps the season-3 burst (9 concurrent from one
                             # harbor-5 island) at 5 while leaving ordinary
                             # traffic untouched. `0` would grant none at all.

# --- bots stay crackable (kept from the fair-world preset: #14 / #16) ---
BOT_GARRISON_RATIO=12        # cap bot standing defence -> no unbeatable turtles
BOT_MORALE_FLOOR=1           # humans fight BOTS at full power; human targets
                             # keep the normal morale shield

# Deliberately NOT set (the defaults ARE the decision):
#   PROTECT_GRACE_HOURS  (default = 72h/speed = 72 real hours at speed 1;
#                         48 was the speed-up preset we're not using)
#   BULLY_RATIO          (3 — the aspirational band, kept)
#   BOTS=20, FREE_ISLES=30, WORLD_THEME=generated, MORALE_FLOOR=0.3,
#   PROTECTED_POINTS=40, WIN_SHARE=0.6, SEASON_AUTO (off — manual lifecycle)
