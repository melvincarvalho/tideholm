# Tideholm — STAGED next-season config (NOT applied; the live game is untouched).
# Speed 1 (classic hours-pace) + the README "fair-world" balance preset.
# Manual lifecycle: SEASON_AUTO is intentionally omitted (default off).
#
# Two values are injected at apply time by apply-next-season.sh and are NOT
# stored here:
#   ADMIN_TOKEN  — read from the running process so the secret never lands in a file
#   WORLD_START  — computed as the next 17:00 Europe/Berlin (or passed as an arg)
#
# Apply only at the SEASON BOUNDARY:  ./deploy/apply-next-season.sh --confirm

# --- pace ---
GAME_SPEED=1                 # classic hours pace (was 5x)

# --- server (preserved from the live process) ---
PORT=3210

# --- fair-world balance preset (Jul-13 work: #7 / #14 / #16) ---
PROTECT_GRACE_HOURS=48       # newcomer shield = 48 REAL hours (independent of speed)
BOT_GARRISON_RATIO=12        # cap bot standing defence -> no unbeatable turtles
BOT_MORALE_FLOOR=1           # leader fights BOTS at full power; humans stay shielded

# Defaults left as-is: BOTS=20, FREE_ISLES=30, WORLD_THEME=generated,
# MORALE_FLOOR=0.3, PROTECTED_POINTS=40, BULLY_RATIO=3, WIN_SHARE=0.6.
